# Simple Makefile for building meds_etl_cpp
# Requires: PyArrow and pybind11 installed

# Use the Python from the current environment
PYTHON := python
CXX := clang++
CXXFLAGS := -std=c++17 -O3 -Wall -fPIC

# Verify Python is available
PYTHON_VERSION := $(shell $(PYTHON) --version 2>&1)
$(info Building with: $(PYTHON_VERSION))

# Get Python and PyArrow paths
PYTHON_INCLUDES := $(shell $(PYTHON) -m pybind11 --includes)
ARROW_INCLUDE := $(shell $(PYTHON) -c "import pyarrow; print(pyarrow.get_include())")
ARROW_LIBDIR := $(shell $(PYTHON) -c "import pyarrow; print(pyarrow.get_library_dirs()[0])")
SUFFIX := $(shell $(PYTHON) -c "import sysconfig; print(sysconfig.get_config_var('EXT_SUFFIX'))")

# Abseil paths
ABSEIL_ROOT := third_party/abseil-cpp
ABSEIL_BUILD := $(ABSEIL_ROOT)/build

# Abseil libraries needed for flat_hash_map/set
ABSEIL_LIBS := \
	$(ABSEIL_BUILD)/absl/container/libabsl_raw_hash_set.a \
	$(ABSEIL_BUILD)/absl/container/libabsl_hashtablez_sampler.a \
	$(ABSEIL_BUILD)/absl/hash/libabsl_hash.a \
	$(ABSEIL_BUILD)/absl/hash/libabsl_city.a \
	$(ABSEIL_BUILD)/absl/hash/libabsl_low_level_hash.a \
	$(ABSEIL_BUILD)/absl/base/libabsl_base.a \
	$(ABSEIL_BUILD)/absl/base/libabsl_spinlock_wait.a \
	$(ABSEIL_BUILD)/absl/base/libabsl_throw_delegate.a \
	$(ABSEIL_BUILD)/absl/base/libabsl_raw_logging_internal.a \
	$(ABSEIL_BUILD)/absl/base/libabsl_log_severity.a

# Auto-detect Arrow library version from PyArrow
ARROW_LIBARROW := $(shell find $(ARROW_LIBDIR) -name "libarrow.*.dylib" -not -name "libarrow_*" | head -1)
ARROW_LIBPARQUET := $(shell find $(ARROW_LIBDIR) -name "libparquet.*.dylib" | head -1)

ifeq ($(ARROW_LIBARROW),)
    $(error Could not find libarrow dylib in $(ARROW_LIBDIR))
endif
ifeq ($(ARROW_LIBPARQUET),)
    $(error Could not find libparquet dylib in $(ARROW_LIBDIR))
endif

# Detect if we're running from native/ or root
ifeq ($(wildcard native/),)
    # Running from native/ directory
    NATIVE_DIR := .
else
    # Running from root directory
    NATIVE_DIR := native
endif

# Source files
SOURCES := $(NATIVE_DIR)/meds_etl_cpp.cc $(NATIVE_DIR)/perform_etl.cc

# Build into package directory as _native module
# The meds_etl_cpp/__init__.py wrapper imports pyarrow first, then this
PACKAGE_DIR := meds_etl_cpp
TARGET := $(PACKAGE_DIR)/_native$(SUFFIX)

# For backwards compatibility, also create the old-style module
LEGACY_TARGET := meds_etl_cpp$(SUFFIX)

.PHONY: all clean install

all: $(TARGET)
	@# Create legacy symlink for backwards compatibility
	@ln -sf $(TARGET) $(LEGACY_TARGET) 2>/dev/null || cp $(TARGET) $(LEGACY_TARGET)

$(TARGET): $(SOURCES) $(ABSEIL_LIBS) | $(PACKAGE_DIR)
	$(CXX) -bundle -undefined dynamic_lookup $(CXXFLAGS) \
		$(PYTHON_INCLUDES) \
		-I$(ARROW_INCLUDE) \
		-I$(ABSEIL_ROOT) \
		-I$(NATIVE_DIR) \
		$(ARROW_LIBARROW) \
		$(ARROW_LIBPARQUET) \
		$(ABSEIL_LIBS) \
		-Wl,-rpath,@loader_path/../pyarrow \
		-Wl,-rpath,@loader_path \
		$(SOURCES) -o $(TARGET)
	@echo "✅ Built $(TARGET)"

$(PACKAGE_DIR):
	mkdir -p $(PACKAGE_DIR)

clean:
	rm -f $(TARGET) $(LEGACY_TARGET) *.o
	rm -f $(PACKAGE_DIR)/_native*.so

install: $(TARGET)
	$(PYTHON) -m pip install -e .

test: $(TARGET)
	$(PYTHON) -c "import meds_etl_cpp; print('✅ Import successful!')"

